{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "scheme": "parkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Park-IT to attach a photo to a parking report."
        }
      ]
    ]
  }
}
